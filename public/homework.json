{
  "title": "作业星球",
  "child": "小宇航员",
  "difficulty": "normal",
  "subjects": [
    {
      "id": "seasons",
      "name": "季节",
      "icon": "🌸",
      "color": "#80ed99",
      "tasks": [
        {
          "id": "seasons-words",
          "title": "Words: spring, summer, fall, winter",
          "standard": "L.K.5",
          "questions": [
            { "q": "🌷🌸 Which season is it?", "options": ["spring", "summer", "fall", "winter"], "a": "spring", "speak": "Which season is it?" },
            { "q": "☀️🏖️ Which season is it?", "options": ["spring", "summer", "fall", "winter"], "a": "summer", "speak": "Which season is it?" },
            { "q": "🍂🍁 Which season is it?", "options": ["spring", "summer", "fall", "winter"], "a": "fall", "speak": "Which season is it?" },
            { "q": "⛄❄️ Which season is it?", "options": ["spring", "summer", "fall", "winter"], "a": "winter", "speak": "Which season is it?" },
            {
              "q": "🔊 Listen and choose.",
              "options": ["🌷 spring", "☀️ summer", "🍂 fall", "⛄ winter"],
              "a": "🍂 fall",
              "speak": "fall",
              "listen": true,
              "standard": "L.K.6",
              "level": ["normal", "hard"]
            },
            { "q": "Which one is NOT a season?", "options": ["spring", "hot", "winter", "summer"], "a": "hot", "level": ["normal", "hard"] },
            {
              "q": "Put the seasons in order.",
              "order": ["🌷 spring", "☀️ summer", "🍂 fall", "⛄ winter"],
              "standard": "L.K.6",
              "level": ["normal", "hard"]
            },
            {
              "q": "Spell the word: ⛄❄️",
              "tiles": ["w", "i", "n", "t", "e", "r", "s"],
              "a": "winter",
              "speak": "winter",
              "standard": "L.K.2",
              "level": "hard"
            }
          ]
        },
        {
          "id": "seasons-sentence",
          "title": "Say it: What season is it? It's spring.",
          "standard": "L.K.1",
          "questions": [
            { "q": "What season is it? 🌷🌸", "tiles": ["It's", "winter.", "spring."], "a": "It's spring.", "speak": "What season is it?" },
            { "q": "What season is it? ⛄❄️", "tiles": ["summer.", "It's", "winter."], "a": "It's winter.", "speak": "What season is it?" },
            { "q": "What season is it? ☀️🏖️", "tiles": ["It's", "summer.", "fall."], "a": "It's summer.", "speak": "What season is it?", "level": ["normal", "hard"] },
            { "q": "What season is it? 🍂🍁", "tiles": ["fall.", "spring.", "It's"], "a": "It's fall.", "speak": "What season is it?", "level": ["normal", "hard"] },
            { "q": "Make the question.", "tiles": ["season", "it?", "What", "is"], "a": "What season is it?", "hint": "问句以 What 开头", "level": "hard" }
          ]
        }
      ]
    },
    {
      "id": "weather",
      "name": "天气",
      "icon": "🌡️",
      "color": "#ffb84d",
      "tasks": [
        {
          "id": "weather-words",
          "title": "Words: hot, cold, cool, warm",
          "standard": "L.K.5",
          "questions": [
            { "q": "🥵🔥 It's ___.", "options": ["hot", "cold", "cool", "warm"], "a": "hot", "speak": "How does it feel?" },
            { "q": "🥶🧊 It's ___.", "options": ["hot", "cold", "cool", "warm"], "a": "cold", "speak": "How does it feel?" },
            { "q": "🌬️🍃 It's ___.", "options": ["hot", "cold", "cool", "warm"], "a": "cool", "speak": "How does it feel?" },
            { "q": "🌤️😊 It's ___.", "options": ["hot", "cold", "cool", "warm"], "a": "warm", "speak": "How does it feel?" },
            {
              "q": "🔊 Listen and choose.",
              "options": ["🥵 hot", "🥶 cold", "🍃 cool", "🌤️ warm"],
              "a": "🌤️ warm",
              "speak": "It's warm.",
              "listen": true,
              "standard": "L.K.6",
              "level": ["normal", "hard"]
            },
            { "q": "The opposite of hot is ___.", "options": ["warm", "cold", "hot"], "a": "cold", "level": ["normal", "hard"] },
            { "q": "The opposite of warm is ___.", "options": ["hot", "cool"], "a": "cool", "hint": "warm 有点热，cool 有点凉", "level": "hard" }
          ]
        },
        {
          "id": "weather-sentence",
          "title": "Say it: It's warm. It's cold. It's hot. It's cool.",
          "standard": "L.K.1",
          "questions": [
            { "q": "In winter ⛄ …", "tiles": ["It's", "cold.", "hot."], "a": "It's cold.", "speak": "In winter, it's..." },
            { "q": "In summer ☀️ …", "tiles": ["hot.", "It's", "cool."], "a": "It's hot.", "speak": "In summer, it's..." },
            { "q": "In spring 🌷 …", "tiles": ["It's", "warm.", "cold."], "a": "It's warm.", "speak": "In spring, it's...", "level": ["normal", "hard"] },
            { "q": "In fall 🍂 …", "tiles": ["cool.", "hot.", "It's"], "a": "It's cool.", "speak": "In fall, it's...", "level": ["normal", "hard"] }
          ]
        }
      ]
    },
    {
      "id": "letter-e",
      "name": "字母 Ee",
      "icon": "🔤",
      "color": "#4cc9f0",
      "tasks": [
        {
          "id": "e-words",
          "title": "Phonics: Ee says /e/ — net, wet, vet, jet",
          "standard": "RF.K.3",
          "questions": [
            { "q": "Build the word: 🥅", "tiles": ["n", "e", "t", "a"], "a": "net", "speak": "net" },
            { "q": "Build the word: 💦", "tiles": ["w", "e", "t", "o"], "a": "wet", "speak": "wet" },
            { "q": "Build the word: 🐶🩺", "tiles": ["v", "e", "t", "i"], "a": "vet", "speak": "vet", "hint": "vet 是给动物看病的医生" },
            { "q": "Build the word: ✈️", "tiles": ["j", "e", "t", "u"], "a": "jet", "speak": "jet" },
            {
              "q": "Which word has the short e sound /e/?",
              "options": ["net", "nut", "not"],
              "a": "net",
              "speak": "Which word has the short e sound? net, nut, or not?"
            },
            {
              "q": "🔊 Listen and choose.",
              "options": ["net", "wet", "vet", "jet"],
              "a": "vet",
              "speak": "vet",
              "listen": true,
              "standard": "RF.K.2",
              "level": ["normal", "hard"]
            },
            { "q": "Which word rhymes with “net”?", "options": ["jet", "cat", "dog"], "a": "jet", "standard": "RF.K.2", "level": ["normal", "hard"] },
            { "q": "Build a new -et word: 🐶🐱🐹", "tiles": ["p", "e", "t", "o"], "a": "pet", "speak": "pet", "hint": "家里养的小动物", "level": "hard" }
          ]
        }
      ]
    },
    {
      "id": "story",
      "name": "故事",
      "icon": "📖",
      "color": "#ff7eb6",
      "tasks": [
        {
          "id": "story-book",
          "title": "Read the Book 2 story with a grown-up",
          "standard": "RL.K.10",
          "note": "跟着课本（或点读笔、音频）读第二本书的故事，边听边用手指着读"
        },
        {
          "id": "story-read",
          "title": "Read: What's Your Favorite Season?",
          "standard": "RL.K.1",
          "passage": {
            "title": "What's Your Favorite Season?",
            "genre": "literature",
            "text": "It is a sunny day. Tom asks Mia, “What's your favorite season?” Mia says, “My favorite season is spring. It's warm, and I like the flowers.” Then Mia asks Tom, “What's your favorite season?” Tom says, “My favorite season is winter. It's cold, and I like the snow!” They both smile. Every season is fun.",
            "vocab": [
              { "word": "favorite", "meaning": "最喜欢的", "emoji": "❤️" },
              { "word": "season", "meaning": "季节", "emoji": "🗓️" },
              { "word": "flowers", "meaning": "花", "emoji": "🌷" },
              { "word": "snow", "meaning": "雪", "emoji": "❄️" }
            ]
          },
          "questions": [
            { "q": "Who are the two friends?", "options": ["Tom and Mia", "Tom and Max", "Mia and Grandma"], "a": "Tom and Mia", "standard": "RL.K.3" },
            { "q": "What is Mia's favorite season?", "options": ["spring", "summer", "winter"], "a": "spring", "evidence": "My favorite season is spring" },
            { "q": "What is Tom's favorite season?", "options": ["fall", "winter", "spring"], "a": "winter", "evidence": "My favorite season is winter" },
            {
              "q": "Why does Mia like spring?",
              "options": ["She likes the flowers.", "She likes the snow.", "She likes the sea."],
              "a": "She likes the flowers.",
              "evidence": "I like the flowers",
              "level": ["normal", "hard"]
            },
            { "q": "Tom says winter is ___.", "options": ["hot", "warm", "cold"], "a": "cold", "evidence": "It's cold", "level": "hard" },
            {
              "q": "Answer like Mia: What's your favorite season? 🌷",
              "tiles": ["My favorite season is", "spring.", "winter."],
              "a": "My favorite season is spring.",
              "speak": "What's your favorite season?",
              "standard": "L.K.1",
              "level": "easy"
            },
            {
              "q": "Answer like Mia: What's your favorite season? 🌷",
              "tiles": ["season", "My", "is", "spring.", "favorite", "winter."],
              "a": "My favorite season is spring.",
              "speak": "What's your favorite season?",
              "standard": "L.K.1",
              "level": ["normal", "hard"]
            }
          ]
        },
        {
          "id": "story-fluency",
          "title": "Fluency: Read the story aloud",
          "standard": "RF.K.4",
          "level": ["normal", "hard"],
          "fluency": { "passage": "story-read" }
        },
        {
          "id": "story-ask",
          "title": "Ask a grown-up: “What's your favorite season?”",
          "standard": "SL.K.1",
          "note": "去问爸爸妈妈，听他们用 “My favorite season is ...” 回答"
        },
        {
          "id": "story-write-easy",
          "title": "Write: My favorite season",
          "standard": "W.K.1",
          "level": "easy",
          "write": { "prompt": "What's your favorite season?", "frame": "My favorite season is ___.", "require": ["season"], "minWords": 5 }
        },
        {
          "id": "story-write",
          "title": "Write: My favorite season",
          "standard": "W.K.1",
          "level": ["normal", "hard"],
          "write": {
            "prompt": "What's your favorite season? Why?",
            "frame": "My favorite season is ___ because ___.",
            "require": ["because"],
            "minWords": 8
          }
        }
      ]
    },
    {
      "id": "unit-seasons",
      "unit": "k-seasons-weather",
      "lessons": ["l1-weather", "l2-winter", "l6-grasshopper"]
    }
