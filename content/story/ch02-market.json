          ]
        },
        {
          "id": "zib-tastes",
          "title": "Zib Tastes Food",
          "text": "Dear friend, Lemons taste sour. When I taste something sour, I make a funny face! Cake tastes sweet. Pretzels taste salty. I like sweet food best! Your friend, Zib",
          "questions": [
            { "q": "How do lemons taste?", "options": ["sour", "sweet", "salty"], "a": "sour", "evidence": "Lemons taste sour" },
            { "q": "What does Zib like best?", "options": ["sweet food", "sour food", "salty food"], "a": "sweet food", "evidence": "I like sweet food best" }
          ]
        },
        {
          "id": "zib-sounds",
          "title": "Zib Hears Sounds",
          "text": "Dear friend, A fire alarm is loud. A whisper is soft. When a sound is too loud, I cover my ears. When I say hi to a big hill, I hear an echo! Your friend, Zib",
          "questions": [
            { "q": "What is soft?", "options": ["a whisper", "a fire alarm", "a big drum"], "a": "a whisper", "evidence": "A whisper is soft" },
            { "q": "What does Zib do when a sound is too loud?", "options": ["covers its ears", "sings a song", "eats a cake"], "a": "covers its ears", "evidence": "I cover my ears" }
          ]
        }
      ]
    },
