          ]
        },
        {
          "id": "zib-seasons",
          "title": "Zib Learns About Earth",
          "text": "Dear friend, Thank you for your letter about the seasons on Earth. In winter, it is cold, and people wear mittens. In spring, the snow and ice thaw, and farmers plant seeds. In summer, it is hot. In autumn, the leaves fall from the trees. I want to see Earth! Your friend, Zib",
          "questions": [
            { "q": "In spring, what do farmers do?", "options": ["They plant seeds.", "They pick pumpkins.", "They wear sunscreen."], "a": "They plant seeds.", "evidence": "farmers plant seeds" },
            { "q": "When do the leaves fall from the trees?", "options": ["in autumn", "in spring", "in summer"], "a": "in autumn", "evidence": "the leaves fall from the trees" }
          ]
        },
        {
          "id": "zib-thermometer",
          "title": "Zib's Thermometer",
          "text": "Dear friend, Look! I have a thermometer now. When it is cold, the liquid stays down low. When it is hot, the liquid goes up high. Today the liquid is up high, so I will swim in the pool to keep cool. Your friend, Zib",
          "questions": [
            { "q": "When it is cold, where is the liquid?", "options": ["down low", "up high"], "a": "down low", "evidence": "the liquid stays down low" },
            { "q": "What will Zib do today?", "options": ["swim in the pool", "build snowmen", "rake leaves"], "a": "swim in the pool", "evidence": "I will swim in the pool" }
          ]
        }
      ]
    },
